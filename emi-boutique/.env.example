# Copia este archivo como .env para pruebas locales. En Netlify estas variables se cargan en el panel (Site configuration > Environment variables).
# NUNCA subas el archivo .env a GitHub.

# --- Supabase ---
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesiones (cadena aleatoria de 32+ caracteres) ---
SESSION_SECRET=

# --- Wompi (llaves de PRUEBA al inicio: pub_test_..., test_integrity_..., test_events_...) ---
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Sitio (sin / al final) ---
SITE_URL=https://TU-SITIO.netlify.app

# --- Correo (opcional; ej. Gmail con contraseña de aplicación) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="EMI Boutique <tu-correo@gmail.com>"

# --- Opcionales ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
AI_API_KEY=
